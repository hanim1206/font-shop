# ── Supabase ──────────────────────────────────────────────
# 로컬: `npm run db:start` 뒤 `npx supabase status` 의 API_URL / PUBLISHABLE_KEY / SECRET_KEY 를 붙여 넣는다
# 배포: Supabase 대시보드 > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx   # 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 말 것

# ── 토스페이먼츠 (API 개별 연동 키) ─────────────────────────
# 토스페이 결제창에는 API 개별 연동 키가 필요하다. 위젯 키(test_gck)는 지원하지 않고, 공개 샘플 키는 동작하지 않는다.
# 개발자센터 > API 키 (https://developers.tosspayments.com/my/api-keys) 의 내 테스트 키를 넣는다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxx
TOSS_SECRET_KEY=test_sk_xxx
TOSS_API_BASE=https://api.tosspayments.com

# ── 워터마크 (fontmark) ────────────────────────────────────
# 길고 랜덤한 값. 바꾸면 이전 파일의 워터마크를 못 읽으니 한 번 정하면 그대로 둔다.  openssl rand -hex 32
FONTMARK_SECRET=
PYTHON=python3

# ── 메일 ──────────────────────────────────────────────────
# resend | mailpit | (비우면 안 보내고 서버 로그에 링크만 출력)
MAIL_PROVIDER=mailpit
RESEND_API_KEY=
MAIL_FROM=Font Shop <onboarding@resend.dev>
# 테스트 기간: 모든 메일을 이 주소로 (Resend 테스트 모드는 가입한 본인 메일로만 보낼 수 있다)
MAIL_TO_OVERRIDE=you@example.com

# ── 사이트 ────────────────────────────────────────────────
SITE_URL=http://localhost:3000
# 관리자 화면(/admin/orders)을 볼 수 있는 계정 이메일 (쉼표로 여러 개)
ADMIN_EMAILS=you@example.com
# 사이트 하단에 보이는 판매자 연락처
NEXT_PUBLIC_SELLER_EMAIL=you@example.com
